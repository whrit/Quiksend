# ── Core (required) ───────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
# Matches docker-compose.yml credentials:
DATABASE_URL=postgres://quiksend:quiksend@localhost:5432/quiksend
# Optional — set to `transaction` when using PgBouncer/Neon pooled endpoints.
# DATABASE_POOLER_MODE=transaction
# Tests run against a SEPARATE database, derived by suffixing the name above
# (`quiksend` -> `quiksend_test`) and created automatically by `pnpm test`.
# The suite truncates tables between cases, so it must never point at the dev
# database. Set this only to override that derivation.
# TEST_DATABASE_URL=postgres://quiksend:quiksend@localhost:5432/quiksend_test

# ── Webhook delivery (Phase 10, optional — defaults shown) ──
# WEBHOOK_SWEEP_INTERVAL_MS=60000
# WEBHOOK_SWEEP_BATCH_SIZE=50
# WEBHOOK_DELIVER_CONCURRENCY=5

# ── Auth (Phase 1) ────────────────────────────────────────────
# Required to run the web app. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public URL the browser hits — MUST match the dev-server port below.
# If 3000 is taken on your host, set WEB_PORT=<free port> and update this
# to match (e.g. http://localhost:3005).
BETTER_AUTH_URL=http://localhost:3000
# Optional — Vite dev-server port. Defaults to 3000; strict-fails on collision
# rather than silently drifting so Better Auth callbacks / Nango webhook tunnels
# never end up pointing at the wrong service.
# WEB_PORT=3000
# Optional social login (leave blank to hide those buttons):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=

# ── Integrations (Phase 3, optional) ──────────────────────────
# NANGO_SECRET_KEY=
# NANGO_WEBHOOK_SECRET=
# Public URL Nango redirects/callbacks land on. For local dev this is your
# ngrok tunnel to WEB_PORT (e.g. https://<subdomain>.ngrok-free.dev); in prod
# it's your own domain. Keep the port here in sync with WEB_PORT if you tunnel
# a non-default port.
# NANGO_PUBLIC_URL=http://localhost:3000

# ── AI (Phase 8 — required in production) ─────────────────────
# Either or both may be set; provider is per-workspace in settings.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=              # Required in production (embeddings).
# AI_DEFAULT_PROVIDER=anthropic

# AI research web search — at least one required in production.
# In dev/test, empty falls back to fake fixtures.
# BRAVE_API_KEY=
# EXA_API_KEY=
# TAVILY_API_KEY=

# ── Mail (Phase 4, optional in dev — SMTP_HOST/SMTP_FROM/TLS required in production) ──
# Local mail testing (Mailpit, from docker-compose.yml):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# Optional relay auth — set both or neither.
# SMTP_USER=
# SMTP_PASS=
# TLS posture — production requires SMTP_SECURE or SMTP_REQUIRE_TLS.
# SMTP_SECURE=0
# SMTP_REQUIRE_TLS=0
# Envelope/header From for transactional (password reset, invitation) mail.
# Required in production; falls back to a dev-only *.local address when unset.
# SMTP_FROM=no-reply@quiksend.example
# SMTP_FROM_NAME=Quiksend
# 32-byte base64 key for encrypting SMTP mailbox credentials at rest.
# Generate with: openssl rand -base64 32
# MAILBOX_ENCRYPTION_KEY=

# ── Enterprise deliverability (Phase 11, optional) ────────────
# Daily send cap per (mailbox, SEG destination) tuple. Consumer ESPs already throttle;
# this is the extra hard cap applied when routing to Proofpoint/Mimecast/Barracuda/Cisco.
# SEG_DAILY_CAP_PER_MAILBOX=50

# Hostname used to strip tracking pixels in the SEG content sanitizer.
# Defaults to the hostname of BETTER_AUTH_URL when unset.
# TRACKING_PIXEL_DOMAIN=track.example.com

# 32-byte base64 key for encrypting provider-managed seed inbox IMAP credentials.
# Deployed only on Quiksend Systems infra to unlock Deliverability Pro's shared seed pool.
# Self-hosters can leave this UNSET — user-provided seed inboxes still work.
# Generate (Quiksend Systems only): openssl rand -base64 32
# SYSTEM_SEED_ENCRYPTION_KEY=

# Bootstrap operator identity — the only account allowed to sign up outside an
# invitation, or create the first organization. REQUIRED in production (self-host
# included); optional in development, where signup stays open when unset.
# Also used for Quiksend Systems provider seed pool alerts + event attribution.
# SYSTEM_ADMIN_EMAIL=
# QUIKSEND_SYSTEM_ORG_ID=

# Signs unsubscribe tokens embedded in outbound messages.
UNSUBSCRIBE_TOKEN_SECRET=dev-unsubscribe-token-secret

# ── Observability (optional) ────────────────────────────────────
# Sentry for errors, PostHog for product analytics.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# ── Worker test / load-test hooks (dev/test only — ignored in production) ──
# QUIKSEND_ENGINE_FAKE_MAIL=1
# QUIKSEND_ENGINE_FORCE_OUTER_ROLLBACK=1
# QUIKSEND_ENGINE_TEST_MODE=permanent-failure
# QUIKSEND_CANARY_IMAP_MOCK=inbox
