# syntax=docker/dockerfile:1
# Migration image. Single-purpose: run bundled migrate.js against production database.
# Bundles packages/db/src/migrate.ts into a standalone JS artifact; no source tree,
# no dev dependencies at runtime.

FROM node:24-slim AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app

# Prune to include @quiksend/db and dependencies (needed for migrations).
FROM base AS pruner
COPY . .
RUN pnpm dlx turbo@2.10.2 prune @quiksend/db --docker

# Build stage: bundle migration TypeScript to JavaScript.
FROM base AS builder
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
RUN pnpm --filter @quiksend/db migrate:build

# Runtime: bundled artifact + migrations folder + runtime deps only.
# Non-root user, no source tree, no dev dependencies.
FROM base AS runner
ENV NODE_ENV=production \
    MIGRATIONS_FOLDER=/app/drizzle

# Create non-root user.
RUN groupadd -r migrate && useradd -r -g migrate migrate

WORKDIR /app

# Copy only the pruned lockfile to install runtime deps (not dev deps).
COPY --from=pruner /app/out/json/ .

# Install production deps only (no dev deps).
RUN pnpm install --frozen-lockfile --prod

# Copy bundled migration script.
COPY --from=builder --chown=migrate:migrate /app/packages/db/dist/migrate.js ./packages/db/dist/migrate.js

# Copy drizzle migrations folder.
COPY --from=builder --chown=migrate:migrate /app/packages/db/drizzle ./drizzle

# Lock down filesystem: drop capabilities, no new privileges, read-only root.
RUN chmod -R 555 ./packages/db/dist ./drizzle
USER migrate

ENTRYPOINT ["node", "packages/db/dist/migrate.js"]
