# syntax=docker/dockerfile:1
# Migration image. Single-purpose: run pnpm db:migrate against production database.
# Uses the full builder stage to have access to source, package.json, pnpm-lock.yaml.

FROM node:24-slim AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app

# Prune to include @quiksend/db and dependencies (needed for migrations).
FROM base AS pruner
COPY . .
RUN pnpm dlx turbo@2.10.2 prune @quiksend/db --docker

# Install and prepare for migrations.
FROM base AS runner
ENV NODE_ENV=production

COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
COPY tsconfig.base.json ./tsconfig.base.json

# Create non-root user.
RUN groupadd -r migrate && useradd -r -g migrate migrate

# Run migrations as non-root.
USER migrate

ENTRYPOINT ["pnpm", "db:migrate"]
